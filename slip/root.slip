-- Ordinary SLIP definitions over the synchronous native core.
not-found: `not-found`
invalid: `invalid`
ordered: {code or list or dict or scope}
mapping: {dict or scope}
number: {int or float}
is-number: fn {x} [(type-of x) = `int` or ((type-of x) = `float`)]
is-string: fn {x} [(type-of x) = `string` or ((type-of x) = `i-string`)]
is-list: fn {x} [(type-of x) = `list`]
is-dict: fn {x} [(type-of x) = `dict`]
is-scope: fn {x} [(type-of x) = `scope`]
is-path: fn {x} [(type-of x) = `path`]
is-fn: fn {x} [(type-of x) = `function`]
is-code: fn {x} [(type-of x) = `code`]
is-boolean: fn {x} [(type-of x) = `boolean`]
is-none: fn {x} [(type-of x) = `none`]
for: fn {vars, start, end, body-block} [
    var-name: extract-simple-param vars
    for-scope: current-scope
    for-scope: for-scope.meta.caller
    body-block: core-bind body-block for-scope vars
    step: if [start <= end] [1] [-1]
    i: start
    while [if [step > 0] [i < end] [i > end]] [
        for-scope[var-name]: i
        core-execute body-block for-scope
        i: i + step
    ]
    none
]
for.meta.binds: 0
when: fn {condition, body} [
    caller: current-scope
    caller: caller.meta.caller
    condition: core-bind condition caller
    body: core-bind body caller
    accepted: core-execute condition caller
    if [accepted] [core-execute body caller]
]
cond: fn {clauses} [
    caller: current-scope
    caller: caller.meta.caller
    foreach {clause} clauses [
        [condition-block, result-expr]: clause
        condition-block: core-bind condition-block caller
        if [core-execute condition-block caller] [
            if [is-code result-expr] [
                result-expr: core-bind result-expr caller
                return (core-execute result-expr caller)
            ]
            return result-expr
        ]
    ]
    none
]
partial: fn {function, bound...} [
    fn {args...} [call function (add bound args)]
]
compose: fn {functions...} [
    fn {value} [
        result: value
        foreach {function} (reverse functions) [
            result: call function #[result]
        ]
        result
    ]
]
Schema: scope #{}
schema: fn {config} [(scope config) |inherit Schema]
is-schema: fn {obj} [is-a obj Schema]
default: fn {value} [#{__marker__: `default`, value: value}]
optional: fn {type} [#{__marker__: `optional`, type: type}]
command-apply: fn {command-scope} [
    context: command-scope.meta.parent
    args: #[]
    foreach {step} context.steps [
        value: command-scope[step.name]
        if [step.hydrate] [value: context.hydrate-object value]
        args: add args #[value]
    ]
    if [context.projected.rest != none] [
        args: add args command-scope[context.projected.rest]
    ]
    call context.command-context.command-callable args
]
command-method: fn {command-context, projected, definition} [
    hydrate-object: run-with [
        fn {object-id} [host-object object-id]
    ] definition
    steps: #[]
    foreach {parameter} projected.parameters [
        hydrate: false
        if [has parameter 'type'] [hydrate: is-scope parameter.type]
        steps: add steps #[#{name: parameter.name, hydrate: hydrate}]
        if [hydrate] [parameter.type: `id`]
    ]
    projected.where: none
    fn (sig projected) [/command-apply (/current-scope)]
]
command: fn {command-callable} [
    foreach {method} command-callable.methods [
        description: get-sig method
        adapter: command-method (/current-scope) description method.meta.parent
    ]
    return adapter
]
